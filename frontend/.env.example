# NGOConnect Frontend Environment Variables Template

# Base URL for REST API calls (defaults to /api/v1 for local Vite proxy)
# For production deployment (e.g., Vercel -> Render backend):
# VITE_API_BASE_URL=https://your-backend-app.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Backend origin URL for resolving backend-hosted static file uploads
# VITE_BACKEND_URL=https://your-backend-app.onrender.com
VITE_BACKEND_URL=http://localhost:8080
